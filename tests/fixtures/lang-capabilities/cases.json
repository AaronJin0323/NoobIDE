{
  "$comment": "Language capability suite (S18.1, S18.2). Each case is run inside the real (packaged) app by src/renderer/editor/capability-probe.ts: '|' marks the cursor. completion: every label in 'expect' must be offered. hover: the hover text must contain every 'expect' string. format: the formatted document must equal 'expectText'. docs/capabilities.md may only list case ids from this file, and the e2e suite requires every case to pass.",
  "cases": [
    {
      "id": "html-tag-completion",
      "language": "html",
      "kind": "completion",
      "text": "<!doctype html>\n<html>\n<body>\n  <butt|\n</body>\n</html>\n",
      "expect": ["button"]
    },
    {
      "id": "html-attribute-completion",
      "language": "html",
      "kind": "completion",
      "text": "<img sr| >\n",
      "expect": ["src"]
    },
    {
      "id": "html-tag-hover",
      "language": "html",
      "kind": "hover",
      "text": "<!doctype html>\n<html>\n<body>\n  <but|ton>OK</button>\n</body>\n</html>\n",
      "expect": ["button"]
    },
    {
      "id": "css-property-completion",
      "language": "css",
      "kind": "completion",
      "text": "h1 {\n  backg|\n}\n",
      "expect": ["background-color"]
    },
    {
      "id": "css-value-completion",
      "language": "css",
      "kind": "completion",
      "text": "p {\n  display: fl|\n}\n",
      "expect": ["flex"]
    },
    {
      "id": "css-property-hover",
      "language": "css",
      "kind": "hover",
      "text": "p {\n  col|or: red;\n}\n",
      "expect": ["color"]
    },
    {
      "id": "js-dom-completion",
      "language": "javascript",
      "kind": "completion",
      "text": "const title = document.getElementBy|\n",
      "expect": ["getElementById"]
    },
    {
      "id": "js-local-name-completion",
      "language": "javascript",
      "kind": "completion",
      "text": "const userName = 'Lin';\nfunction greet() {\n  return 'Hi ' + user|\n}\n",
      "expect": ["userName"]
    },
    {
      "id": "js-dom-hover",
      "language": "javascript",
      "kind": "hover",
      "text": "const box = document.query|Selector('#box');\n",
      "expect": ["querySelector"]
    },
    {
      "id": "js-local-hover",
      "language": "javascript",
      "kind": "hover",
      "text": "const userName = 'Lin';\nconsole.log(user|Name);\n",
      "expect": ["userName"]
    }
  ]
}
