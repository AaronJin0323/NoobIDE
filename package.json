{
  "name": "noobide",
  "productName": "NoobIDE",
  "version": "0.0.0",
  "private": true,
  "description": "A beginner-friendly desktop IDE for HTML / CSS / JavaScript.",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "session": "node harness/session.mjs",
    "verify": "node harness/verify.mjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "selftest:packaged": "node scripts/selftest.mjs --packaged",
    "selftest:dev": "node scripts/selftest.mjs --dev"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "electron": "44.7.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
